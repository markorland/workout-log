# Dockge stack .env for PocketBase. In Dockge, paste these into the stack's
# .env editor (or save as /mnt/HDDs/Docker/DockgeStacks/pocketbase/.env).
# Never commit the real file.
#
# The PocketBase admin (superuser) account. Created on first start and reset
# to these values on every start, so change the password here, not in the
# admin UI. Wrap the password in single quotes if it contains $, # or spaces.
PB_ADMIN_EMAIL=you@example.com
PB_ADMIN_PASSWORD='change-me-to-something-long'
